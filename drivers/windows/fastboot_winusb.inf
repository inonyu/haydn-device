; Android fastboot interface for Windows.
;
; Windows has no inbox driver for the fastboot/bootloader interface, so a phone
; sitting in bootloader mode shows up as an unknown device and `fastboot devices`
; prints nothing. This binds WinUSB to it, which is all fastboot needs.
;
; Scope: exactly two hardware ids, the Android bootloader ones. Nothing else is
; touched. See docs/install.md for why the phone ends up in this mode.
;
; Install (needs an Administrator prompt) — see docs/install.md for the three
; conditions that have to hold, and drivers/windows/README.md for the script:
;   makecat fastboot.cdf; signtool sign /sm ...; pnputil /add-driver ... /install
;
; Dev_AddReg must carry Google's fastboot interface GUID, {F72FE0D4-CBCB-407d-8814-9ED673D0DD6B}.
; fastboot.exe enumerates devices by that interface class, not by VID/PID: with a
; different GUID the driver binds and ''fastboot devices'' still prints nothing.

[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGuid   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %ProviderName%
CatalogFile = fastboot_winusb.cat
DriverVer   = 11/13/2026,1.0.0.0

[Manufacturer]
%ProviderName% = DeviceList, NTamd64

[DeviceList.NTamd64]
%DeviceName% = USB_Install, USB\VID_18D1&PID_D00D
%DeviceName% = USB_Install, USB\VID_18D1&PID_D00D&MI_01
%DeviceName% = USB_Install, USB\VID_2717&PID_FF48

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[USB_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{F72FE0D4-CBCB-407d-8814-9ED673D0DD6B}"

[Strings]
ProviderName = "haydn-device"
DeviceName   = "Android Fastboot"